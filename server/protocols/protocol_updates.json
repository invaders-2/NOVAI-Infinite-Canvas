        "video": [
          "muse-video-ext"
        ],
        "audio": []
      },
      "protocol_changes": [
        {
          "field": "model_catalog_endpoints",
          "from": "",
          "to": "GET /v1/models?expand=category|parameters; GET /v1/models/{id}/schema",
          "note": "文档确证：可拉取模型能力与参数 JSON Schema（image/video 有 parameters，chat/audio 只有 category 与 capability_tags）。"
        },
        {
          "field": "idempotency_key",
          "from": "",
          "to": "支持请求头 Idempotency-Key（1-191 可见 ASCII，约 24h 保留；重放带 Idempotency-Replayed: true，冲突 409）",
          "note": "文档确证；项目当前未带该头，超时重试存在重复计费风险。"
        },
        {
          "field": "chat_completions_stream_default",
          "from": "false",
          "to": "true",
          "note": "文档确证且明确说与 OpenAI 相反：省略 stream 时默认流式；非流式调用必须显式传 stream=false。"
        },
        {
          "field": "response_envelope",
          "from": "{code,data}",
          "to": "/v1/messages 与 /v1/responses 不包 {code,data}（/v1/chat|images|videos|tasks|music 仍包）",
          "note": "文档确证：两种包装要分开解析，错误体 {error:{code,message,type}} 不包。"
        },
        {
          "field": "model_id_alias_conflict",
          "from": "seedream-4-5 / seedream-4-0",
          "to": "seedream-4.5 / seedream-4.0",
          "note": "只记录不自动改：文档标准写法与项目本地目录不同，自动重命名用户已有模型有风险。"
        }
      ]
    },
