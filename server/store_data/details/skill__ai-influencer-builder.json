  "guide": {
    "summary": "在这里准备需求草稿，就绪后从画布发送。选定三个角色方向之一，并在最终成片前确认完整的无对白视频草稿。",
    "scenarios": [
      "孵化一个虚拟博主账号",
      "自己出镜前先测试内容赛道",
      "给品牌打造固定出镜的虚拟代言人"
    ],
    "required_context": [
      {
        "title": "外形特征",
        "description": "全部可选。未填的选择会补全并说明；明确的风格、比例和角色选择会被保留。"
      },
      {
        "title": "参考照片",
        "description": "可选。请使用你有权使用的照片。人物身份参考需要本人同意；不支持公众人物。"
      }
    ],
    "use_cases": [],
    "steps": [
      {
        "title": "设定角色",
        "description": "选择特质和视频构想，然后在画布上查看并发送可编辑的需求草稿。"
      },
      {
        "title": "选定形象",
        "description": "比较同一自然基底的三个方向并选定肖像。Agent 会检查七视图，并将两份参考一并保存。"
      },
      {
        "title": "确认视频",
        "description": "查看费用和完整的无对白视频草稿。你确认后，成片会在后期加入字幕、音乐和 AI 角色标识。"
      }
    ],
    "outputs": [
      "角色需求草稿",
      "已选定肖像与已检查的七视图",
      "带两份参考的可复用角色",
      "确认视频草稿后的 9:16 视频",
      "配文、话题标签、封面和下一条内容构想"
    ],
    "follow_ups": [
      "用同一角色拍下一种格式",
      "给 TA 做一组本周 photo dump"
    ],
    "boundaries": [
      "人物角色必须是成年人。可用的身份照片需要本人同意；不支持公众人物。真实动物保留符合物种的身体结构与动作。",
      "默认无对白。对白需要明确要求，且相应能力要支持。",
      "生成会消耗积分。首次付费视频请求前会确认视频费用；不会自动发布。"
    ]
  },
