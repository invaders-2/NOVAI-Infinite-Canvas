# 之前漏在 .gitignore 外，会随 git add -A 混进仓库，这里补齐。
data/canvas_versions/
data/agent_sessions/
data/runs/
data/tasks/
data/assets_registry.json
data/asset_hashes.json
data/memory_library.json
data/persona_library.json
